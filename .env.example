NODE_ENV=development
DATABASE_URL=mysql://bar:bar_local_password@127.0.0.1:3306/bar_saas
REDIS_URL=redis://127.0.0.1:6379
API_PORT=3000
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
# Gere com: openssl rand -hex 32 (chave de 32 bytes em hexadecimal)
DOCUMENT_KEY=
PAYMENT_WEBHOOK_SECRET=
# Configure explicitamente antes de executar db:seed
SEED_PASSWORD=
SEED_DEMO=false
PRINT_API_URL=http://localhost:3000/api/v1
PRINT_AGENT_TOKEN=
PRINT_PRINTER_ID=
# Alternativa para vários dispositivos: JSON {"<printer-uuid>":{"host":"192.168.1.10","port":9100}}
# PRINT_PRINTERS_JSON=
PRINT_HOST=127.0.0.1
PRINT_PORT=9100
# Origem pública do aplicativo do cliente, incorporada no build do painel
VITE_CUSTOMER_URL=http://localhost:5174
# Endereços públicos dos aplicativos de equipe para compartilhar credenciais
VITE_ADMIN_URL=http://localhost:5173
VITE_WAITER_URL=http://localhost:5175
VITE_KITCHEN_URL=http://localhost:5176

# URL pública do cardápio incorporada no QR das mesas pelo servidor
CUSTOMER_PUBLIC_URL=http://localhost:5174

# Web Push: gere o par uma única vez com pnpm push:keys. Preserve-o entre deploys.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://mesa.userp.com.br
# Serviços de push permitidos (proteção de requisições externas).
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,fcmregistrations.googleapis.com,push.services.mozilla.com,web.push.apple.com,notify.windows.com,wns.windows.com
