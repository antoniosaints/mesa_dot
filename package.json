{
  "name": "bar-saas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' --filter '!@bar/print-agent' dev",
    "dev:api": "pnpm --filter @bar/api dev",
    "dev:admin": "pnpm --filter @bar/admin-web dev",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs && pnpm -r --filter @bar/admin-web --filter @bar/customer-pwa --filter @bar/waiter-pwa --filter @bar/kitchen-display build && node scripts/copy-pwa-shells.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude 'tests/integration/**' --exclude 'tests/e2e/**'",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:provision": "tsx scripts/provision.ts",
    "start:api": "node --env-file=.env dist/apps/api/src/index.js",
    "start:worker": "node --env-file=.env dist/apps/worker/src/index.js",
    "start:print": "node --env-file=.env dist/apps/print-agent/src/index.js",
    "local:start": "node scripts/local.mjs start",
    "local:stop": "node scripts/local.mjs stop",
    "local:status": "node scripts/local.mjs status",
    "saas:bootstrap": "tsx scripts/bootstrap-saas-root.ts",
    "push:keys": "node scripts/setup-web-push.mjs"
  },
  "dependencies": {
    "@antoniosantos1999/printbridge": "0.1.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "bullmq": "^5.0.0",
    "bwip-js": "^4.0.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.0.0",
    "jsqr": "1.4.0",
    "lucide-react": "^1.61.0",
    "maska": "^3.2.2",
    "mysql2": "^3.0.0",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.5.0",
    "socket.io": "^4.0.0",
    "socket.io-client": "^4.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
