# Valores públicos para o ambiente de produção; mescle com os segredos do servidor.
# Não substitua o .env usado no desenvolvimento local por este arquivo.
CORS_ORIGINS=https://mesa.userp.com.br
VITE_ADMIN_URL=https://mesa.userp.com.br
ADMIN_PUBLIC_URL=https://mesa.userp.com.br
# Complementos: preencha no ambiente protegido da API. Não use prefixo VITE em segredos.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=https://mesa.userp.com.br/api/v1/complements/mercadopago/callback
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TEST_MODE=false
# API na mesma origem HTTPS, encaminhada pelo Nginx em /api/ e /socket.io/.
VITE_API_URL=
PRINT_API_URL=https://mesa.userp.com.br/api/v1
# Configure separadamente as origens HTTPS dos aplicativos cliente, garçom e cozinha.
# Acrescente essas origens a CORS_ORIGINS quando forem publicadas.

# Gere o par VAPID uma única vez no servidor com pnpm push:keys.
# Preserve a chave privada apenas no .env protegido da API e do worker.
WEB_PUSH_SUBJECT=https://mesa.userp.com.br
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
