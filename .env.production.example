# Copie para .env.production; preencha os segredos antes de iniciar.
# Os quatro nomes precisam ser distintos e ter DNS para o mesmo servidor.
ADMIN_DOMAIN=mesa.userp.com.br
CUSTOMER_DOMAIN=app.mesa.userp.com.br
WAITER_DOMAIN=garcom.mesa.userp.com.br
KITCHEN_DOMAIN=cozinha.mesa.userp.com.br
MESA_IMAGE_TAG=local
MYSQL_DATABASE=mesa
MYSQL_USER=mesa
# Use openssl rand -hex 32 para CADA segredo abaixo. Hex evita escape em URLs.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
DOCUMENT_KEY=
PAYMENT_WEBHOOK_SECRET=
# Gere uma única vez com o comando do README. Preserve o par nos próximos deploys.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://mesa.userp.com.br
