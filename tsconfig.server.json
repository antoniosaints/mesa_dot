{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "apps/api/src",
    "apps/worker/src",
    "apps/print-agent/src",
    "packages/database/src",
    "packages/shared/src",
    "scripts/provision.ts",
    "scripts/bootstrap-saas-root.ts"
  ],
  "exclude": ["**/dist", "node_modules"]
}
